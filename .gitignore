# ==============================================================================
# Git Ignore - MicroProse Shandalar Modern ANSI C Engine
# ==============================================================================

# Build Output & Binaries
build/
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# Redundant Intermediate Function Exports
**/functions/
functions/

# Temporary / Scratch Files
*.swp
*.swo
*~
.DS_Store
__pycache__/
*.pyc

# Local-only source material (game installers, Windows ISOs, etc.) -- never
# commit these: copyrighted, large, and not something to publish on the fork.
sources/
